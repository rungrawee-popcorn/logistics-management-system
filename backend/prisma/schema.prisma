generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RIDER
  CUSTOMER
}

enum RiderStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum OrderStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  CREDIT_CARD
}

model User {
  id           String  @id @default(uuid())
  fullName     String  @map("full_name")
  email        String  @unique
  phone        String?
  passwordHash String  @map("password_hash")

  role UserRole

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rider              Rider?
  customerOrders     Order[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  orderStatusUpdates OrderStatusHistory[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Rider {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  vehicleType  String @map("vehicle_type")
  licensePlate String @unique @map("license_plate")

  status RiderStatus @default(AVAILABLE)

  createdAt DateTime @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]
  trackingLocations TrackingLocation[]

  @@index([status])
  @@map("riders")
}

model Order {
  id String @id @default(uuid())

  trackingCode String @unique @map("tracking_code")

  customerId String  @map("customer_id")
  riderId    String? @map("rider_id")

  status OrderStatus @default(PENDING)

  pickupAddress   String @map("pickup_address")
  deliveryAddress String @map("delivery_address")

  pickupLatitude  Decimal @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude Decimal @map("pickup_longitude") @db.Decimal(10, 7)

  deliveryLatitude  Decimal @map("delivery_latitude") @db.Decimal(10, 7)
  deliveryLongitude Decimal @map("delivery_longitude") @db.Decimal(10, 7)

  distanceKm Decimal @map("distance_km") @db.Decimal(10, 2)

  deliveryFee Decimal @map("delivery_fee") @db.Decimal(10, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(10, 2)

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id])
  rider    Rider? @relation(fields: [riderId], references: [id])

  payment Payment?

  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([riderId])
  @@index([status])
  @@index([trackingCode])
  @@map("orders")
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId   String @map("order_id")
  updatedBy String @map("updated_by")

  status OrderStatus

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  user User @relation(fields: [updatedBy], references: [id])

  @@index([orderId])
  @@index([updatedBy])
  @@map("order_status_history")
}

model TrackingLocation {
  id String @id @default(uuid())

  riderId String @map("rider_id")

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at")

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([createdAt])
  @@map("tracking_locations")
}

model Notification {
  id String @id @default(uuid())

  userId String @map("user_id")

  title   String
  message String

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Payment {
  id String @id @default(uuid())

  orderId String @unique @map("order_id")

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @map("payment_method")

  status PaymentStatus @default(PENDING)

  transactionRef String? @map("transaction_ref")

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String @map("user_id")

  token String

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id String @id @default(uuid())

  userId String @map("user_id")

  action String

  module String

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@map("audit_logs")
}
